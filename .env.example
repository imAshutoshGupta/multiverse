# From Supabase → Project Settings → API (or "Connect")
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Optional, server only: lets the owner add/remove staff logins from Settings → Staff.
# Supabase → Project Settings → API Keys → Secret keys. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Optional, server only: lets the owner find game posters in Settings → Games.
# Free key: https://rawg.io/apidocs (images must credit RAWG; the site does this automatically).
RAWG_API_KEY=
